{
  "name": "wongames",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "workspaces": [
    "client",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:client\" \"bun run dev:api\"",
    "dev:client": "bun run --cwd ./client dev",
    "dev:api": "bun run --cwd ./api dev",

    "build": "bun run build:client && bun run build:api",
    "build:client": "bun run --cwd ./client build",
    "build:api": "bun run --cwd ./api build",

    "lint": "concurrently \"bun run lint:client\" \"bun run lint:api\"",
    "lint:client": "bun run --cwd ./client lint",
    "lint:api": "bun run --cwd ./api lint",

    "typecheck": "concurrently \"bun run typecheck:client\" \"bun run typecheck:api\"",
    "typecheck:client": "bun run --cwd ./client typecheck",
    "typecheck:api": "bun run --cwd ./api typecheck",

    "test": "bun run test:client",
    "test:client": "bun run --cwd ./client test",
    "test:ci": "bun run --cwd ./client test:ci",

    "codegen": "bun run --cwd ./client codegen",
    "storybook": "bun run --cwd ./client storybook"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "overrides": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/minimatch": "5.1.2",
    "ajv": "8.16.0"
  }
}